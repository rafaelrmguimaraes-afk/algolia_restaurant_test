# Local configuration. Copy this file to .env and fill in the values there.
# Comments must stay on their own lines because our parser supports simple KEY=value syntax.
# Application ID identifies your Algolia application; it is not a secret.
ALGOLIA_APP_ID=
# The complete demo index. restaurants_test remains the earlier four-record experiment.
ALGOLIA_INDEX_NAME=restaurants
# Browser-visible: read-only search access, ideally restricted to this index.
ALGOLIA_SEARCH_API_KEY=
# Private: used only by Python to upload records and apply index settings.
ALGOLIA_WRITE_API_KEY=
